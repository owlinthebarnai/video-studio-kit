      "repo": "repos/cth9191_animate",
      "skill": "animate",
      "status": "verified",
      "example": "fire",
      "what": "One-canvas procedural animation with a synthesized score. Styles: cut paper, crosshatch, riso, sketchbook, math, pixel, isometric.",
