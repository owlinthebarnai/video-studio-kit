        }
      ],
      "build": "demos/painted: src/scenes/<scene>.js hooked in studio.html, src/config.js duration; node render.mjs --sheet=...; node render.mjs --clip --out=out/x.mp4. (Setup script needs rsync: copy the template by hand on Windows.)"
    },
    {
      "id": "kinetic",
      "group": "makers",
      "name": "kinetic-reel",
      "repo": "repos/tuzhechen2005_opus-video-skills",
      "skill": "kinetic-reel",
      "status": "verified",
      "example": "fire",
      "what": "Bold kinetic typography reels with HUD micro-type, three.js layers (particle terrain, liquid marble, chrome knot) and a beat-locked synth score. 16:9.",
      "speed": "~0.1 s per frame",
      "needs": "nothing",
      "styles": [
        {
          "id": "type",
          "name": "Kinetic type",
          "example": "examples/kinetic-reel--fire.mp4"
        }
      ],
      "build": "demos/kinetic: reel/cues.js (scene starts + hits), reel/reel.js (one function per shot, SCENES, TR); music/score.mjs must match the cue names; npm run frames; node music/score.mjs; npm run encode."
    },
    {
      "id": "whatif",
