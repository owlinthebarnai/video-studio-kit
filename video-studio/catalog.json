      "build": "demos/animate/pieces/<name>: piece.json + src/{head.html,scenes.js,bridges.js,score.js}; node .claude/skills/animate/tools/build.mjs <piece>; tools/still.mjs; tools/export.mjs <piece> --share."
    },
    {
      "id": "painted",
      "group": "makers",
      "name": "painted-animation (+ ClaudeAnimationBase)",
      "repo": "repos/tuzhechen2005_opus-video-skills · repos/JohnHeibel_ClaudeAnimationBase",
      "skill": "painted-animation",
      "status": "verified",
      "example": "fire",
      "what": "Hand-painted watercolour and boiling ink (p5.js + p5.brush), 16:9. Both repos are the same engine.",
      "speed": "1-4 s per frame on this GPU (5 s = ~5 min)",
